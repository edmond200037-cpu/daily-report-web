1" value="OAuth 回傳&lt;br&gt;處理成功？" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="431" width="210" height="98" as="geometry"/></mxCell><mxCell id="p2b" value="記錄 accountError&lt;br&gt;hash 改為 #settings/account" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="446" width="210" height="68" as="geometry"/></mxCell><mxCell id="p3" value="還原記憶／水位分區快取&lt;br&gt;restoreActive*Partition&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748b&quot;&gt;src/data/*-partition.ts&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="558" width="210" height="68" as="geometry"/></mxCell><mxCell id="p4" value="loadDailyDraft&lt;br&gt;new DailyController(...)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748b&quot;&gt;src/daily/daily-controller.ts&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="210" height="68" as="geometry"/></mxCell><mxCell id="p5" value="舊進料補 materialTypeId&lt;br&gt;（舊資料遷移，必要時 flush）" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="782" width="210" height="68" as="geometry"/></mxCell><mxCell id="p6" value="refreshActiveMemoryCache&lt;br&gt;persist 分區、refreshDailySyncStatus" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="894" width="210" height="68" as="geometry"/></mxCell><mxCell id="p7" value="loadActiveSharedScope&lt;br&gt;→ 工地、角色、lastPulledAt&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748b&quot;&gt;src/sync/context.ts&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1006" width="210" height="68" as="geometry"/></mxCell><mxCell id="p8" value="renderApp()&lt;br&gt;（見「3 路由與渲染」）" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1118" width="210" height="68" as="geometry"/></mxCell><mxCell id="p9" value="僅 PROD：registerSW&lt;br&gt;（見「10 PWA 更新」）" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="210" height="68" as="geometry"/></mxCell><mxCell id="p10" value="scheduleBackgroundSync&lt;br&gt;（見「7 同步引擎」）" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1342" width="210" height="68" as="geometry"/></mxCell><mxCell id="e1" value="顯示「無法開啟施工日報」&lt;br&gt;請確認允許本機資料儲存" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="782" width="210" height="62" as="geometry"/></mxCell><mxCell id="n1" value="啟動順序重點：&lt;br&gt;1. 先還原分區快取，再建立控制器&lt;br&gt;2. 草稿載入後才算帳號／工地範圍&lt;br&gt;3. 任何一步丟錯 → 整體失敗畫面" style="shape=note;size=12;fillColor=#fffde7;strokeColor=#bda63c;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="590" y="558" width="260" height="110" as="geometry"/></mxCell><mxCell id=