row=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="p2" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p5" name="5 預覽、定稿與複製"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="txt1" value="功能流程｜定稿並複製（定稿快照不可回寫）" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;fontSize=22;fontStyle=1;fontColor=#173f3a;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1400" height="34" as="geometry"/></mxCell><mxCell id="txt2" value="來源：依 2026-11-21 的 main 分支程式碼靜讀整理；未實際跑完所有互動。 對應 daily-events「finalize」與 finalizeDailyReport。" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;fontSize=12;fontColor=#50605d;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1600" height="28" as="geometry"/></mxCell><mxCell id="s0" value="按「定稿並複製」" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="210" height="62" as="geometry"/></mxCell><mxCell id="d0" value="聯絡草稿&lt;br&gt;尚未完成？" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="207" width="210" height="98" as="geometry"/></mxCell><mxCell id="e0" value="alert：請先完成或取消" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="540" y="222" width="210" height="62" as="geometry"/></mxCell><mxCell id="d1" value="finalizeInFlight？" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="319" width="210" height="98" as="geometry"/></mxCell><mxCell id="e1" value="略過（防重複點擊）" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="540" y="334" width="210" height="62" as="geometry"/></mxCell><mxCell id="p1" value="鎖按鈕「本機定稿中…」&lt;br&gt;capturePendingWork + flush 草稿" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="446" width="210" height="68" as="geometry"/></mxCell><mxCell id="p2" value="validateDailyForFinalization&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748b&quot;&gt;src/daily/daily-validator.ts&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="558" width="210" height="68" as="geometry"/></mxCell><mxCell id="d2" value="有未完成項目？" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="655" width="210" height="98" as="geometry"/></mxCell><mxCell id="e2" value="alert 列出問題&lt;br&gt;草稿保留" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="540" y="670" width="210" height="62" as="geometry"/></mxCell><mxCell id="p3" value="formatDailyReport → outputText&lt;br&gt;（output-model 分組 → 官方模板）&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748b&quot;&gt;src/daily/daily-formatter.ts&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="782" width="210" height="68" as="geometry"/></mxCell><mxCell id="p4" value="finalizeDailyReport(report, outputText)&lt;br&gt;commitId＝使用者:工地:日期 或 local:日期&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748b&quot;&gt;src/data/daily-repository.ts&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="894" width="210" height="76" as="geometry"/></mxCell><mxCell id="d3" value="SHA-256 指紋&lt;br&gt;＝既有 commit？" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="991" width="210" height="98" as="geometry"/></mxCell><mxCell id="p5" value="回傳既有快照&lt;br&gt;created=false&lt;br&gt;不新增快照、不重複累計記憶" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1140.3999999999999" width="210" height="80" as="geometry"/></mxCell><mxCell id="p6" value="單一 IndexedDB 交易（任一失敗整次失敗）&lt;br&gt;寫 daily_reports 快照 + daily_memory_commits&lt;br&gt;保留 live_report_draft、更新記憶主檔" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="540" y="1140.3999999999999" width="270" height="100" as="geometry"/></mxCell><mxCell id="p7" value="草稿 = retainedDraft&lt;br&gt;clipboard.writeText(outputText)" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="1297.2" width="210" height="68" as="geometry"/></mxCell><mxCell id="d4" value="剪貼簿允許？" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="1394.2" width="210" height="98" as="geometry"/></mxCell><mxCell id="p7b" value="提示：本機已定稿&lt;br&gt;請再按「複製」" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="540" y="1409.2" width="210" height="68" as="geometry"/></mxCell><mxCell id="p8" value="背景：commitInputMemories → scheduleBackgroundSync&lt;br&gt;失敗只提示「記憶更新待重試」，不回滾定稿" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="1543.6000000000001" width="210" height="76" as="geometry"/></mxCell><mxCell id="e3" value="finally：解鎖按鈕、renderApp" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="1666.8" width="210" height="62" as="geometry"/></mxCell><mxCell id="n1" value="規則&lt;br&gt;• 定稿快照不可被主檔改名／刪除／草稿編輯改動&lt;br&gt;• 本機保留 7 個日曆日（啟動與開歷史頁會 pruneExpiredReports）&lt;br&gt;• 「複製」（不定稿）只做 formatDailyReport → 剪貼簿&lt;br&gt;• 預覽與定稿使用同一個 formatter" style="shape=note;size=12;fillColor=#fffde7;strokeColor=#bda63c;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="865" y="222" width="340" height="150" as="geometry"/></mxCell><mxCell id="n2" value="finalizeDailyReport 一次操作 10 個 store、單行最長 2,300+ 字元，&lt;br&gt;難以審查與測試。建議拆為：collectMemoryIncrements（純函式）＋ commitFinalize（交易），&lt;br&gt;行為與格式不變，沿用 daily-finalization 測試當護欄。" style="shape=note;size=12;fillColor=#ffebee;strokeColor=#c62828;fontColor=#7f1d1d;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="865" y="1006" width="340" height="130" as="geometry"/></mxCell><mxCell id="n3" value="未實作（CLAUDE.md §9）：雲端定稿 RPC、&lt;br&gt;定稿快照跨裝置歷史——定稿仍僅存本機。" style="shape=note;size=12;fillColor=#fffde7;strokeColor=#bda63c;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="865" y="1342" width="340" height="70" as="geometry"/></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s0" target="d0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d0" target="e0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge5" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d0" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge6" value="是" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="e1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge7" value="否" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="d1" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell