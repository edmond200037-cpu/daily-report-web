gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="222" width="210" height="80" as="geometry"/></mxCell><mxCell id="p2" value="DailyController 方法&lt;br&gt;addTrade / addWorkItem / connectMaterial…&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748b&quot;&gt;src/daily/daily-controller.ts&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="334" width="210" height="68" as="geometry"/></mxCell><mxCell id="p3" value="update(mutator)&lt;br&gt;變更 → refreshCompleteness → updatedAt&lt;br&gt;onSaveState(&quot;saving&quot;)" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="446" width="210" height="80" as="geometry"/></mxCell><mxCell id="p4" value="debounce 600ms&lt;br&gt;連續輸入會重置計時" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="558" width="210" height="68" as="geometry"/></mxCell><mxCell id="p5" value="flush() → saveDailyDraft(report, baseline)&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748b&quot;&gt;src/data/daily-repository.ts&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="670" width="210" height="68" as="geometry"/></mxCell><mxCell id="d1" value="已啟用共用工地？" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="767" width="210" height="98" as="geometry"/></mxCell><mxCell id="p6" value="IndexedDB 交易：&lt;br&gt;live_report_draft + draft_partitions" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="916.4" width="220" height="68" as="geometry"/></mxCell><mxCell id="d2" value="report.shared 與&lt;br&gt;目前 scope 相符？" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="540" y="901.4" width="210" height="98" as="geometry"/></mxCell><mxCell id="e1" value="拒寫：工地已切換&lt;br&gt;停止舊工地寫入" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="790" y="916.4" width="210" height="62" as="geometry"/></mxCell><mxCell id="p7" value="buildFieldMutations&lt;br&gt;與 baseline 做欄位 diff（穩定 ID）&lt;br&gt;同一交易寫 draft + outbox &quot;daily-patch&quot;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748b&quot;&gt;src/sync/field-mutations.ts&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="540" y="1084.3999999999999" width="210" height="84" as="geometry"/></mxCell><mxCell id="p8" value="onSaveState(&quot;saved&quot;)&lt;br&gt;更新時間、待同步數 refreshDailySyncStatus" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="1230" width="210" height="68" as="geometry"/></mxCell><mxCell id="p9" value="共用模式：scheduleBackgroundSync&lt;br&gt;（見「7 同步引擎」）" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="1342" width="210" height="68" as="geometry"/></mxCell><mxCell id="c1" value="輸入提交點&lt;br&gt;commitInputMemories → recordMemoryApplications&lt;br&gt;（見「6 記憶」）" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="10" y="334" width="210" height="84" as="geometry"/></mxCell><mxCell id="n1" value="日報資料（DailyReportV3）&lt;br&gt;• engineering 施工紀錄：工種→工項（含位置、人數）&lt;br&gt;• supplies 進料：普通／獨立；獨立進料最多連接一個工程條目&lt;br&gt;• contacts 聯絡事項　• special 特殊事項" style="shape=note;size=12;fillColor=#fffde7;strokeColor=#bda63c;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="790" y="222" width="330" height="120" as="geometry"/></mxCell><mxCell id="n2" value="不算 dirty、不觸發保存的純 UI 暫態：&lt;br&gt;展開收合、頁籤、焦點、未提交輸入、Bottom Sheet 開關。&lt;br&gt;切換日期／工地期間暫停表單；舊背景結果作廢。" style="shape=note;size=12;fillColor=#fffde7;strokeColor=#bda63c;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="790" y="558" width="330" height="100" as="geometry"/></mxCell><mxCell id="n3" value="handleDailyAction 為 54 分支 if/else 長鏈；UI 暫態（IME 旗標、展開 id…）&lt;br&gt;與資料狀態同放在 appState。建議：action registry（動作名→處理函式），&lt;br&gt;暫態獨立成 uiState，確保不進 mutation。" style="shape=note;size=12;fillColor=#ffebee;strokeColor=#c62828;fontColor=#7f1d1d;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="790" y="1118" width="330" height="120" as="geometry"/></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="s0" target="p1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="" style="edge