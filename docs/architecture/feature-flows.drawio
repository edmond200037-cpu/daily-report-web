Unlocked。" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;fontSize=12;fontColor=#50605d;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1600" height="28" as="geometry"/></mxCell><mxCell id="t1" value="背景定時／online／&lt;br&gt;分頁回前景" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="210" height="62" as="geometry"/></mxCell><mxCell id="t2" value="Realtime：site_changes INSERT&lt;br&gt;（只是提示，不帶資料）" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="290" y="110" width="230" height="62" as="geometry"/></mxCell><mxCell id="t3" value="手動「立即同步」" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="540" y="110" width="210" height="62" as="geometry"/></mxCell><mxCell id="t4" value="本機寫入後&lt;br&gt;scheduleBackgroundSync" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="790" y="110" width="210" height="62" as="geometry"/></mxCell><mxCell id="g" value="略過條件？工地／日期切換中、&lt;br&gt;已在同步、離線、頁面隱藏" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="415" y="230.20000000000002" width="260" height="98" as="geometry"/></mxCell><mxCell id="gs" value="略過本次" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="840" y="245.20000000000002" width="210" height="62" as="geometry"/></mxCell><mxCell id="s1" value="loadActiveSharedScope&lt;br&gt;無 scope → 取消 Realtime 訂閱、結束" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="415" y="380.40000000000003" width="240" height="68" as="geometry"/></mxCell><mxCell id="s2" value="runSyncOnce → withWorkspaceLock&lt;br&gt;確認 scope 仍是目前工地，否則丟錯" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="415" y="484.40000000000003" width="240" height="68" as="geometry"/></mxCell><mxCell id="pl1" value="① pullRemoteChanges&lt;br&gt;pull_site_changes(cursor, limit 100)" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="415" y="588.4" width="240" height="68" as="geometry"/></mxCell><mxCell id="pl2" value="每文件只取最後事件、依 sequence 套用&lt;br&gt;checkRemotePayload 驗證（非法列隔離備份）" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="415" y="692.4" width="260" height="76" as="geometry"/></mxCell><mxCell id="pe" value="拉取失敗：回報 pullError&lt;br&gt;不進入推送" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="890" y="692.4" width="230" height="62" as="geometry"/></mxCell><mxCell id="ph1" value="② 修復重複記憶 23505&lt;br&gt;（雲端優先，備份後採用雲端列）" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="415" y="796.4" width="240" height="68" as="geometry"/></mxCell><mxCell id="ph2" value="③ listReadyOperations（canRetryAt）&lt;br&gt;conflict／blocked 不重試；sending 逾 60 秒可重送" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="415" y="900.4" width="270" height="76" as="geometry"/></mxCell><mxCell id="ph3" value="markOperationSending → pushOperation&lt;br&gt;依 entity 選 RPC：daily-patch／memory-entry／water-patch…" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="415" y="1004.4" width="270" height="76" as="geometry"/></mxCell><mxCell id="dr" value="RPC 回應？" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="415" y="1114.2" width="210" height="98" as="geometry"/></mxCell><mxCell id="ok" value="applied／duplicate&lt;br&gt;acceptMutation → acknowledgeOperation&lt;br&gt;（自 outbox 移除）" style="rounded=1;arcSize=12;fillColor=#e8f5e9;strokeColor=#2e7d32;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="1254" width="210" height="80" as="geometry"/></mxCell><mxCell id="cf" value="conflict&lt;br&gt;preserveConflict：永久備份&lt;br&gt;本機操作＋雲端內容 → 衝突審核項" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="415" y="1254" width="240" height="80" as="geometry"/></mxCell><mxCell id="er" value="錯誤 classifySyncError&lt;br&gt;缺 RPC／權限／格式 → blocked（不重試）&lt;br&gt;其他 → 指數退避 1s→60s" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="790" y="1254" width="250" height="84" as="geometry"/></mxCell><mxCell id="fin" value="④ 有套用 → 再 pull 一次&lt;br&gt;回傳 SyncRunResult → 更新 UI 提示" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="415" y="1399.6000000000001" width="250" height="62" as="geometry"/></mxCell><mxCell id="ob" value="sync_outbox&lt;br&gt;（IndexedDB）" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="940" y="900.4" width="180" height="80" as="geometry"/></mxCell><mxCell id="rm" value="Supabase RPC + RLS&lt;br&gt;site_changes 序號" style="rounded=1;arcSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="940" y="1066.8" width="200" height="76" as="geometry"/></mxCell><mxCell id="cr1" value="帳號頁：衝突審核&lt;br&gt;listConflictReviews／diffConflict&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748b&quot;&gt;src/sync/conflict-review.ts&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#d5f0ea;strokeColor=#3a8f7e;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1290" y="588.4" width="240" height="68" as="geometry"/></mxCell><mxCell id="cr2" value="使用者選：保留本機／採用雲端／逐欄合併" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1290" y="713.1999999999999" width="240" height="68" as="geometry"/></mxCell><mxCell id="cr3" value="queueConflictResolution&lt;br&gt;先永久備份 → 新 outbox 操作" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1290" y="838" width="240" height="68" as="geometry"/></mxCell><mxCell id="rc" value="同步復原：previewSyncRecovery&lt;br&gt;→ applySyncRecovery（先備份）&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#64748b&quot;&gt;src/sync/recovery.ts&lt;/font&gt;" style="rounded=1;arcSize=12;fillColor=#d5f0ea;strokeColor=#3a8f7e;fontFamily=Microsoft Jh