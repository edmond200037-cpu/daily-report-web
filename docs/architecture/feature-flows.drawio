ry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="使用者按「更新」" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="available" target="applying"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge5" value="onNeedReload→重新載入" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="applying" target="success"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge6" value="15 秒逾時" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="applying" target="waiting"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge7" value="再按「更新」" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="waiting" target="applying"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge8" value="丟錯／註冊失敗" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="applying" target="error"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge9" value="重試" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="error" target="applying"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge10" value="略過 dismiss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="available" target="idle"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge11" value="自動 dismiss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="success" target="idle"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a1" value="按「更新」時：&lt;br&gt;flush 草稿 + persist 記憶/水位分區" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="692.4" width="250" height="68" as="geometry"/></mxCell><mxCell id="a2" value="applyPwaUpdate()&lt;br&gt;（SW skipWaiting）" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="365" y="692.4" width="210" height="68" as="geometry"/></mxCell><mxCell id="a3" value="onNeedReload：寫 sessionStorage 標記&lt;br&gt;location.reload()" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="665" y="692.4" width="240" height="68" as="geometry"/></mxCell><mxCell id="a4" value="重載後 consumePwaUpdateSuccess&lt;br&gt;→ success 提示" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="990" y="692.4" width="240" height="68" as="geometry"/></mxCell><mxCell id="edge12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a2" target="a3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a3" target="a4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n1" value="Service Worker 只快取 App Shell；導航網路優先、失敗回退快取 index.html。&lt;br&gt;日報資料絕不進 SW 快取。" style="shape=note;size=12;fillColor=#fffde7;strokeColor=#bda63c;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="894" width="520" height="76" as="geometry"/></mxCell><mxCell id="n2" value="部署快取與手機實機的更新行為尚未完整驗收（CLAUDE.md §9）。&lt;br&gt;狀態機本身是純函式、有單元測試，是目前最乾淨的模組——重構時可當範本。" style="shape=note;size=12;fillColor=#ffebee;strokeColor=#c62828;fontColor=#7f1d1d;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="640" y="894" width="460" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="p11" name="11 重構與簡化建議"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="txt1" value="重構建議｜現況問題 → 目標分層 → 分階段路線" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;fontSize=22;fontStyle=1;fontColor=#173f3a;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="1400" height="34" as="geometry"/></mxCell><mxCell id="txt2" value="來源：依 2026-11-21 的 main 分支程式碼靜讀整理；未實際跑完所有互動。 依你的規則：schema／備份格式／formatter／定稿規則不動；大範圍重排版需你同意。" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;fontSize=12;fontColor=#50605d;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1600" height="28" as="geometry"/></mxCell><mxCell id="h1" value="① 循環依賴&lt;br&gt;daily/views、settings/views、account、app、water-shell 共 10 檔 import main.ts（renderApp／parseRoute）" style="shape=note;size=12;fillColor=#ffebee;strokeColor=#c62828;fontColor=#7f1d1d;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="330" height="90" as="geometry"/></mxCell><mxCell id="h2" value="② appState 單一全域類別&lt;br&gt;資料、UI 暫態、IME 旗標、同步旗標混放，難保證「暫態不進 mutation」" style="shape=note;size=12;fillColor=#ffebee;strokeColor=#c62828;fontColor=#7f1d1d;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="222" width="330" height="90" as="geometry"/></mxCell><mxCell id="h3" value="③ 長行&lt;br&gt;main.ts 最長 4,916 字元／行；daily-repository 82 行 &amp;gt;200 字元。審查與 diff 成本高" style="shape=note;size=12;fillColor=#ffebee;strokeColor=#c62828;fontColor=#7f1d1d;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="334" width="330" height="90" as="geometry"/></mxCell><mxCell id="h4" value="④ 事件分派&lt;br&gt;main.ts click 內設定頁長 if 鏈；handleDailyAction 約 54 分支" style="shape=note;size=12;fillColor=#ffebee;strokeColor=#c62828;fontColor=#7f1d1d;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="446" width="330" height="80" as="geometry"/></mxCell><mxCell id="h5" value="⑤ 遺留與並存&lt;br&gt;src/core、src/db、空的 src/modules/special；sync 新舊 entity 並存" style="shape=note;size=12;fillColor=#ffebee;strokeColor=#c62828;fontColor=#7f1d1d;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="558" width="330" height="80" as="geometry"/></mxCell><mxCell id="h6" value="現況不是問題（保留）：&lt;br&gt;repository／sync 的資料契約、定稿與記憶規則、&lt;br&gt;299 個測試、PWA 狀態機、分區隔離" style="rounded=1;dashed=1;fillColor=#f5f5f5;strokeColor=#9e9e9e;fontColor=#616161;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="330" height="80" as="geometry"/></mxCell><mxCell id="g1" value="app/router.ts&lt;br&gt;parseRoute＋舊網址轉址（純函式）" style="rounded=1;arcSize=12;fillColor=#e8f5e9;strokeColor=#2e7d32;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="490" y="110" width="270" height="68" as="geometry"/></mxCell><mxCell id="g2" value="app/render.ts&lt;br&gt;route table：loader＋view；&lt;br&gt;只管 renderToken 與掛載（不 import main）" style="rounded=1;arcSize=12;fillColor=#e8f5e9;strokeColor=#2e7d32;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="490" y="222" width="270" height="80" as="geometry"/></mxCell><mxCell id="g3" value="actions registry&lt;br&gt;動作名 → 處理函式（日報／設定／帳號／水位各一份）&lt;br&gt;取代 if 鏈" style="rounded=1;arcSize=12;fillColor=#e8f5e9;strokeColor=#2e7d32;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="490" y="334" width="270" height="84" as="geometry"/></mxCell><mxCell id="g4" value="state slices&lt;br&gt;session（帳號／工地）· daily · ui 暫態（不進 mutation）· sync" style="rounded=1;arcSize=12;fillColor=#e8f5e9;strokeColor=#2e7d32;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="490" y="446" width="270" height="76" as="geometry"/></mxCell><mxCell id="g5" value="不動：repository／sync／domain／formatter／db.js" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="490" y="558" width="270" height="68" as="geometry"/></mxCell><mxCell id="edge3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="g4" target="g5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r0" value="S0 護欄&lt;br&gt;npm run check:release 全綠（現為 55 檔／299 測試通過）&lt;br&gt;+ 補 e2e 冒煙" style="ellipse;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="970" y="110" width="300" height="76" as="geometry"/></mxCell><mxCell id="r1" value="S1 抽 router.ts / render.ts&lt;br&gt;純搬移，切斷對 main 的反向 import" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="970" y="222" width="300" height="70" as="geometry"/></mxCell><mxCell id="r2" value="S2 拆 appState 為 slices&lt;br&gt;保留相容 getter，逐檔遷移" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="970" y="334" width="300" height="70" as="geometry"/></mxCell><mxCell id="r3" value="S3 actions registry&lt;br&gt;先設定頁，再日報頁" style="rounded=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="970" y="446" width="300" height="70" as="geometry"/></mxCell><mxCell id="r4" value="S4 需你決定：&lt;br&gt;刪遺留？重排長行？" style="rhombus;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="970" y="554.1999999999999" width="300" height="98" as="geometry"/></mxCell><mxCell id="r5" value="S5（選）sync 移除 legacy 路徑&lt;br&gt;水位轉 TS——涉資料／規則，另寫 ADR" style="ellipse;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="970" y="714.8000000000001" width="300" height="76" as="geometry"/></mxCell><mxCell id="edge7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r0" target="r1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r1" target="r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r2" target="r3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r3" target="r4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="edge11" value="同意後" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontFamily=Microsoft JhengHei;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r4" target="r5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="u0" value="介面簡化候選（只看過 日報首頁／設定首頁／帳號未登入 三個畫面）" style="shape=note;size=12;fillColor=#fffde7;strokeColor=#bda63c;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1480" y="110" width="360" height="56" as="geometry"/></mxCell><mxCell id="u1" value="1. 日報首屏：頁首、模組頁籤、工作區橫幅、日期、工地 → 先 5 層才到「新增施工紀錄」。&lt;br&gt;   可把「日期＋工地」併成一列；本機模式把工作區橫幅收成頁首小標記。" style="shape=note;size=12;fillColor=#fffde7;strokeColor=#bda63c;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1480" y="222" width="360" height="100" as="geometry"/></mxCell><mxCell id="u2" value="2. 設定首頁：7 個入口＋腳註 3 連結（備份、同步診斷、記憶審核）。&lt;br&gt;   低頻項目可合併為「資料與診斷」；「記憶審核」可在主檔旁顯示待審核數徽章。" style="shape=note;size=12;fillColor=#fffde7;strokeColor=#bda63c;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1480" y="345.20000000000005" width="360" height="100" as="geometry"/></mxCell><mxCell id="u3" value="3. 帳號頁：已登入狀態職責過多（見第 8 頁）。&lt;br&gt;   已登入畫面、進料連接、記憶審核頁我尚未實際走過，簡化前需先看。" style="shape=note;size=12;fillColor=#fffde7;strokeColor=#bda63c;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1480" y="468.40000000000003" width="360" height="90" as="geometry"/></mxCell><mxCell id="u4" value="不建議：重做水位頁或全站導覽（CLAUDE.md 禁止）；&lt;br&gt;不建議砍分頁——使用頻率未量測，先量再砍。" style="shape=note;size=12;fillColor=#ffebee;strokeColor=#c62828;fontColor=#7f1d1d;align=left;spacing=8;verticalAlign=top;fontFamily=Microsoft JhengHei;fontSize=13;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="1480" y="591.5999999999999" width="360" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
